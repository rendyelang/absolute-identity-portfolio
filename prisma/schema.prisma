// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed
}

model Profile {
  id          String  @id @default(cuid())
  name        String
  title       String  // e.g., "Mahasiswa Ilmu Komputer"
  titleEn     String? // e.g., "CS Student & Developer"
  bio         String
  bioEn       String?
  avatarUrl   String?
  resumeUrl   String? // path to CV PDF
  githubUrl   String?
  linkedinUrl String?
  email       String?
}

model Experience {
  id          String   @id @default(cuid())
  title       String   // e.g., "Magang Frontend Developer"
  titleEn     String?  // e.g., "Frontend Developer Intern"
  company     String
  location    String?
  logoUrl     String?  // url to the company/institution logo
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String
  descriptionEn String?
  order       Int      @default(0)
}

model Education {
  id          String   @id @default(cuid())
  institution String   // e.g., "Universitas Nusa Putra"
  degree      String   // e.g., "S1 Teknik Informatika"
  startDate   String   // e.g., "2023"
  endDate     String?  // e.g., "Sekarang" or "2027"
  gpa         String?  // e.g., "3.94"
  logoUrl     String?  // url to the school's logo
  order       Int      @default(0)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  description String
  descriptionEn String?
  longDesc    String?
  longDescEn  String?
  imageUrl    String?  // project screenshot/overview image
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  tags        Tag[]
  techStacks  TechStack[]
  createdAt   DateTime @default(now())
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique  // "Web", "Mobile", "AI", etc.
  color    String?   // optional accent color
  projects Project[]
}

model TechStack {
  id       String    @id @default(cuid())
  name     String    @unique  // "React", "TailwindCSS", "Python", etc.
  iconUrl  String?   // URL or path to the tech icon
  projects Project[]
}

model Certificate {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  issuer        String
  date          String
  description   String?
  descriptionEn String?
  imageUrl      String
  credentialUrl String?
  order         Int      @default(0)
}

model Activity {
  id            String   @id @default(cuid())
  title         String   // e.g., "Bangkit Academy 2024"
  titleEn       String?  // e.g., "Bangkit Academy 2024"
  organizer     String   // e.g., "Google, GoTo, Traveloka"
  type          String   // "bootcamp" | "competition"
  logoUrl       String?  // organizer/event logo
  date          String   // e.g., "Feb 2024" or "2024"
  endDate       String?  // e.g., "Jun 2024" (null if single-day event)
  achievement   String?  // e.g., "Juara 2 Nasional"
  achievementEn String?  // e.g., "2nd Place National"
  description   String   // description in Bahasa
  descriptionEn String?  // description in English
  certificateUrl String? // link to certificate/credential
  order         Int      @default(0)
}
